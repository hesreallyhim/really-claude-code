{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,os,sys; p=os.path.join(os.environ[\"CLAUDE_PLUGIN_ROOT\"],\"files\",\"session-start-context.txt\"); print(json.dumps({\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":open(p).read()}}))'"
          }
        ]
      }
    ]
  }
}
