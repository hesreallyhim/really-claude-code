{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,os; print(json.dumps({\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":open(os.environ[\"CLAUDE_PLUGIN_ROOT\"]+\"/hooks/session-start-context.txt\").read()}}))'"
          }
        ]
      }
    ]
  }
}
